{
    "name": "pingomni-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "PingOmni company website: the home of RadiusOne and the One product family. Static Vite + React build.",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/prerender.mjs",
        "preview": "vite preview",
        "types:check": "tsc --noEmit",
        "test": "node --test tests/*.test.ts && php tests/api.test.php"
    },
    "dependencies": {
        "@fontsource-variable/chivo": "^5.3.0",
        "@fontsource-variable/chivo-mono": "^5.3.0",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "typescript": "5.9.3",
        "vite": "8.3.4"
    }
}
